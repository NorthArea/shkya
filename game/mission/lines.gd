const ACCOUNT_OFFICER := "СОТРУДНИК ГСУМ"

## Время показа текста: 0,8 с на «заметить» + 0,25 с на слово (TEXT-01, D).
const READ_BASE := 0.8
const READ_PER_WORD := 0.25

## Слова строки: куски между пробелами, в которых есть буква или цифра («—» и «…» не считаются).
static func word_count(text: String) -> int:
	var n := 0
	for part in text.split(" ", false):
		for ch in part:
			if ch.to_lower() != ch.to_upper() or (ch >= "0" and ch <= "9"):
				n += 1
				break
	return n

## Сколько секунд текст должен быть на экране, чтобы его успели прочитать.
static func read_seconds(text: String) -> float:
	return READ_BASE + READ_PER_WORD * word_count(text)

