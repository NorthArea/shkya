class_name QuestLines
extends RefCounted
## Все реплики и подписи диалогов демо «За хлебом» и расширения «Ничего необычного» (EXT-01, часть L).
## Единственное место текстов: оригинальные черновики на согласование с правообладателем ШКЯ
## (docs/extension/DIALOGUES_AND_JOKES.md, «Редакторский контроль»). Слова «мобилизация» и «бусификация»
## здесь не звучат — смысл считывается вторым слоем (docs/extension/README.md).
##
## Голоса (редакция 28.10.2026, «сделать смешными в стиле ШКЯ»): Бабка — ворчливая и практичная, учит внука
## уличной премудрости; Илюша — буквальный, на всё один ответ «за хлебом» — и это всегда чистая правда;
## продавщица — усталая, считает; полицейский — протокол, записывает ровно то, что видит; сотрудник ГСУМ —
## приветлив и невозмутим; радио — бодрый диктор. Юмор — из столкновения бытовой просьбы с логикой собеседника,
## принятой как норма; панчлайн — последней репликой цепочки, ничего не объясняется в лоб.
##
## Сквозной гэг: Бабка выдаёт Илюше формулу «кто спросит — ты за хлебом». Илюша отвечает ею всем,
## включая саму Бабку, — и формула совпадает с правдой так плотно, что ей никто не верит.
##
## Цепочка — массив строк {speaker, text, portrait}: DialogPanel.open_chain() показывает их по одной,
## «ДАЛЬШЕ» (или E после допечатки) переключает, варианты ответа — только на последней.
## Портрет — id персонажа для DialogPanel.PORTRAIT_REGION (рисунок assets/art/characters/<id>_front_idle.svg).
##
## Счёт за миссию (не более 5–7 реплик, ACCEPTANCE_TESTS «UX / баланс»): Бабка-выдача, радио, полицейский,
## «военком», продавщица, Бабка-возврат, Бабка-сдача — семь; из них наблюдатели и радио — три.

const BABKA := "БАБКА"
const VENDOR := "ПРОДАВЩИЦА"
const ILYUSHA := "ИЛЮША"
const OFFICER := "ПОЛИЦЕЙСКИЙ"
## «Военком» (id account_officer): в игре — сотрудник вымышленной Городской службы уточнения маршрутов.
const ACCOUNT_OFFICER := "СОТРУДНИК ГСУМ"

# --- этап 1: выдача (ПРИНЯТЬ / ОТКАЗАТЬСЯ) ---
## Канон DEMO.md «Илюша, сходи за хлебом в киоск» + Бабкина формула на все случаи жизни.
## Илюша примет её буквально и будет отвечать ею всем, Бабке тоже (см. RETURN_CHAIN, THANKS_AFTER).
const OFFER := "Илюша, сходи за хлебом в киоск. Кто спросит — ты за хлебом"
const BUTTON_ACCEPT := "ПРИНЯТЬ"
const BUTTON_DECLINE := "ОТКАЗАТЬСЯ"

# --- Бабка без дела: до покупки — инструктаж, после сдачи — прощание ---
## До покупки Бабка заранее подсказывает ответ «Я УЖЕ РЯДОМ» — тот самый, который у автобуса не сработает.
const IDLE := "Батон, белый. Подвезти предложат — говори, что уже рядом"
## «Отходил» — и «нагулялся», и «отбыл своё»; второй слой без нажима.
const IDLE_DONE := "Иди погрейся. Ты на сегодня своё отходил"
const BUTTON_CLOSE := "ЛАДНО"

# --- этап 2: радио при посадке в машину (субтитр, не блокирует управление) ---
## Название расширения в эфире; очевидцы того, что ничего не произошло, приглашаются явиться.
const RADIO := "Радио: в городе Н. минус двенадцать и ничего необычного. Очевидцев просим явиться"
const RADIO_SECONDS := 6.0

# --- этап 5: полицейский у киоска (по E до обнаружения), выход свободный ---
## Протокольная логика: идёт за хлебом — значит, хлеба у него нет; отсутствие хлеба фиксируется как факт.
## Отзывается в тосте после провала с хлебом: «ХЛЕБ ПРИ ВАС».
const OFFICER_CHAIN := [
	{"speaker": OFFICER, "text": "Гражданин, цель вашего нахождения у киоска?", "portrait": &"officer"},
	{"speaker": ILYUSHA, "text": "За хлебом", "portrait": &"ilyusha"},
	{"speaker": OFFICER, "text": "Так и запишем: хлеба при себе не имеет", "portrait": &"officer"},
]
const BUTTON_OFFICER_LEAVE := "ПОЙДУ Я"

# --- «военком» у автобуса (e01): два варианта ответа, итог один ---
## Один ответ на оба варианта (ограничение кода) обращён в шутку: сотрудник сам говорит, что ответы
## бывают разные, а итог у всех один. Илюша на выходе даёт третий «разный» ответ — свою формулу.
const ACCOUNT_OFFICER_ASK := {"speaker": ACCOUNT_OFFICER, "text": "Вас подвезти? Бесплатно. Куда — уточним по дороге", "portrait": &"account_officer"}
const BUTTON_RIDE_NO := "НЕТ, СПАСИБО"
const BUTTON_RIDE_NEAR := "Я УЖЕ РЯДОМ"
const ACCOUNT_OFFICER_REPLY := {"speaker": ACCOUNT_OFFICER, "text": "Понимаю. Сначала все отвечают по-разному", "portrait": &"account_officer"}
const BUTTON_RIDE_LEAVE := "Я ЗА ХЛЕБОМ"

# --- этап 6: продавщица, первый подход — цепочка, покупка в конце ---
## Канон этапа 6 расширения: «Пока что» — и сразу цена, без паузы на осмысление.
const VENDOR_CHAIN := [
	{"speaker": VENDOR, "text": "Батон один?", "portrait": &"vendor"},
	{"speaker": ILYUSHA, "text": "Один", "portrait": &"ilyusha"},
	{"speaker": VENDOR, "text": "А вас сколько?", "portrait": &"vendor"},
	{"speaker": ILYUSHA, "text": "Тоже один", "portrait": &"ilyusha"},
	{"speaker": VENDOR, "text": "Пока что. 35 рублей", "portrait": &"vendor"},
]
## Повторный подход без покупки: короткая реплика, цепочка не повторяется (канон DEMO.md, раздел 5).
const VENDOR_AGAIN := "Батон? 35 рублей"
const BUTTON_BUY := "КУПИТЬ ХЛЕБ"
const BUTTON_LEAVE := "УЙТИ"

# --- этап 9: Бабка при возврате с хлебом, затем сдача ---
## Бабка не верит собственной легенде: «за хлебом» — это для чужих. Но легенда и есть правда.
const RETURN_CHAIN := [
	{"speaker": BABKA, "text": "Ты где был? Я уже в окно глядела", "portrait": &"babka"},
	{"speaker": ILYUSHA, "text": "За хлебом", "portrait": &"ilyusha"},
	{"speaker": BABKA, "text": "Это ты им говори. Мне правду скажи", "portrait": &"babka"},
	{"speaker": ILYUSHA, "text": "За хлебом", "portrait": &"ilyusha"},
]
const BUTTON_TURN_IN := "СДАТЬ ХЛЕБ"

# --- этап 10: сдача — два пузыря над Бабкой подряд, пауза между ними ---
## Канон DEMO.md «Спасибо, Илюша» + этап 10 расширения; второй пузырь — после взгляда на улицу:
## формула окончательно отрывается от смысла — за молоком тоже «за хлебом».
const THANKS := "Спасибо, Илюша. Завтра за молоком сходишь"
const THANKS_AFTER := "Спросят — скажешь, за хлебом"
const THANKS_PAUSE := 0.8

const BUTTON_NEXT := "ДАЛЬШЕ"
