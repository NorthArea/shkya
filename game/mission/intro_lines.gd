extends RefCounted
## Тексты вступительной заставки INTRO-01 (решение владельца 29.10.2026): Илюша листает ленту новостей в телефоне —
## в городе ничего не происходит, всё идёт по плану; «Пойду прогуляюсь» — и игра начинается.
## STORY-01 (поручение владельца 30.10): три поста паблика — «ничего не происходит», «всё, что не происходит, — для
## вашего блага» и патрули «для вашего блага»: игрок заранее знает, что патрули есть и их лучше обходить.
## Отдельно от QuestLines (game/mission/lines.gd): реплики квеста правит сценарист, заставку — INTRO-01/STORY-01.
## Слов «мобилизация»/«бусификация» здесь нет и быть не должно (проверка tests/intro_test.gd).

## Шапка ленты новостей на экране телефона.
const FEED_TITLE := "НОВОСТИ ГОРОДА Н."
## Посты по очереди: Илюша смахивает каждый следующим свайпом. Заголовок ≤ 5 слов, текст ≤ 12 слов (STORY-01).
const HEADLINES: Array[String] = [
	"Ничего не происходит",
	"Всё идёт по плану",
	"Патрули — для вашего блага",
]
## Текст поста под заголовком, по одному на пост.
const BODIES: Array[String] = [
	"В городе Н. снова ничего не происходит.",
	"Всё, что не происходит, — для вашего блага.",
	"Встреча с патрулём — уже событие. Обходите патрули стороной.",
]
## Строка под постом: реакции паблика (последняя — подводка к предупреждению Бабки, WARN-01).
const FOOTERS: Array[String] = ["Нравится: 1254", "Комментарии закрыты", "Бабке не нравится"]
## Подпись под заголовком (время публикации), по одной на пост.
const STAMPS: Array[String] = ["только что", "2 мин назад", "5 мин назад"]
## Реплика Илюши после ленты — пузырь над ним, как пузыри квеста.
const GO_FOR_A_WALK := "Пойду прогуляюсь"
## Подсказка пропуска в углу экрана.
const SKIP_HINT := "ПРОПУСТИТЬ"

## Всё, что читается на посте k (заголовок, текст, реакции) — по этому тексту считается время показа (TEXT-01).
static func post_text(k: int) -> String:
	return "%s %s %s" % [HEADLINES[k], BODIES[k], FOOTERS[k]]

## Все строки заставки — для проверки запрещённых слов.
static func all_texts() -> Array[String]:
	var texts: Array[String] = [FEED_TITLE, GO_FOR_A_WALK, SKIP_HINT]
	texts.append_array(HEADLINES)
	texts.append_array(BODIES)
	texts.append_array(FOOTERS)
	texts.append_array(STAMPS)
	return texts
