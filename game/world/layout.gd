# короткий путь к окну (5,9 с). Вне любого конуса: от постов полицейского 20,2 и 15,1 м при дальности 12 м; от стоянок
# автобуса ГСУМ — улица A и площадка (20,6 м); машина после провала «в машине» встаёт на конец ROUTE_DRIVE в 5,8 м.
const STEALTH_CHECKPOINT := Vector3(55.0, 0.0, -51.0)
const STEALTH_CHECKPOINT_YAW := 0.0                        # лицом на север, к площадке и киоску

# Кольцо арены (ARENA-01, контракт C8): по часовой стрелке при взгляде с севера, все повороты правые,
# движение правостороннее. A на запад → D (новая, x = −60) на север → C (новая, z = −100) на восток → B на юг.
# Транспорт едет по правой полосе: смещение RING_LANE от оси улицы, скругление углов — у транспорта.
# По RING ходит троллейбус; машины (ARENA-01 fix P2-2, решение интегратора) — во встречном направлении по
# CAR_RING: B на север → C на запад → D на юг → A на восток, по своей правой полосе (A z = 35, B x = 73,
# C z = −103, D x = −63), все повороты левые. Колонны за троллейбусом (7 м/с против 9) больше нет.
const RING: Array[Vector3] = [Vector3(70, 0, 32), Vector3(-60, 0, 32), Vector3(-60, 0, -100), Vector3(70, 0, -100)]
const CAR_RING: Array[Vector3] = [Vector3(70, 0, 32), Vector3(70, 0, -100), Vector3(-60, 0, -100), Vector3(-60, 0, 32)]
const RING_LANE := 3.0
# Остановки троллейбуса (13-й): улица A, северная сторона, x = −30; улица B у павильона киоска (KIOSK_PAVILION).
const TROLLEY_STOPS: Array[Vector3] = [Vector3(-30, 0, 29), Vector3(67, 0, -62)]
const TRAFFIC_CARS := 3

## Ось правой полосы кольца (C8): RING со смещением RING_LANE вправо по ходу, углы скруглены радиусом radius.
## Замкнутая ломаная — только дуги углов, прямые между ними подразумеваются; начинается с угла RING[0] (A∩B).
## Для проверок геометрии кольца (GREY01, STUCK); транспорт строит свой путь сам (часть T).
## cars = true — полоса машин по CAR_RING (левые повороты, начало — угол A∩B, B на север).
static func ring_lane(radius := 6.0, arc_steps := 6, cars := false) -> Array[Vector3]:
	var ring: Array[Vector3] = CAR_RING if cars else RING
	var out: Array[Vector3] = []
	var n := ring.size()
	for i in n:
		var c := ring[i]
		var d_in := (c - ring[(i - 1 + n) % n]).normalized()
		var d_out := (ring[(i + 1) % n] - c).normalized()
		var right_in := Vector3(-d_in.z, 0, d_in.x)      # вправо по ходу: x — восток, z — юг
		var right_out := Vector3(-d_out.z, 0, d_out.x)
		var side := 1.0 if right_in.dot(d_out) > 0.0 else -1.0   # правый поворот — центр дуги справа, левый — слева
		var corner := c + (right_in + right_out) * RING_LANE
		var center := corner - d_in * radius + right_in * radius * side
		for k in arc_steps + 1:
			var a := PI * 0.5 * k / arc_steps
			out.append(center - right_in * radius * side * cos(a) + d_in * radius * sin(a))
	return out

# Опоры контактной сети через 24 м (сверка ART-04, черта 13). Улица A: x = −66 стоял бы на краю улицы D — сдвинут на −72.
static func a_spans() -> Array[float]:
	var out: Array[float] = []
	for x in range(-90, 100, 24):
		out.append(-72.0 if x == -66 else float(x))
	return out
const B_SPANS: Array[float] = [10.0, -14.0, -38.0, -62.0, -86.0]
# Улицы D и C (ARENA-01): фонарь на консоли — у внешней обочины кольца (D — запад, C — север), во внутренней — опора
# без фонаря; поперечина между ними. Столбы — у бордюра, в валу, как восточные фонари B.
const D_SPANS: Array[float] = [18.0, -10.0, -34.0, -58.0, -82.0]
const C_SPANS: Array[float] = [-42.0, -18.0, 6.0, 30.0, 54.0]
const LAMP_D_WEST := -67.0
const POLE_D_EAST := -53.0
const LAMP_C_NORTH := -107.0
const POLE_C_SOUTH := -93.0
# Внешние углы кольца C∩D и C∩B: опоры, на которые оттянут поворот контактных проводов.
const CORNER_POLES: Array[Vector2] = [Vector2(-69, -109), Vector2(79, -109)]

## Опоры контактной сети без фонаря: TROLLEY_POLES и внутренняя сторона улиц C и D.
static func trolley_poles() -> Array[Vector2]:
	var out: Array[Vector2] = TROLLEY_POLES.duplicate()
	for z in D_SPANS:
		out.append(Vector2(POLE_D_EAST, z))
	for x in C_SPANS:
		out.append(Vector2(x, POLE_C_SOUTH))
	out.append_array(CORNER_POLES)
	return out

## Уличные фонари вдоль тротуаров, с пропусками у переходов маршрута. [центр x/z].
static func street_lamps() -> Array[Vector2]:
	var points: Array[Vector2] = []
	for x in a_spans():
		points.append(Vector2(x, 22.0))                    # улица A, север
		if absf(x) > 26:
			points.append(Vector2(x, 42.0))                # улица A, юг (без выезда со двора)
	for z in B_SPANS:
		if z > -60 or z < -94:
			points.append(Vector2(LAMP_B_WEST, z))         # улица B, запад (без площадки киоска)
		points.append(Vector2(LAMP_B_EAST, z))             # улица B, восток, у бордюра
	for z in D_SPANS:
		points.append(Vector2(LAMP_D_WEST, z))             # улица D, запад, у бордюра
	for x in C_SPANS:
		points.append(Vector2(x, LAMP_C_NORTH))            # улица C, север, у бордюра
	return points

## Отрезки валов: от `from` до `to` кусками по 26 м с разрывом 3 м, затем без участков из cuts ([от, до]).
## Куски короче 2 м отбрасываются.
static func _bank_runs(from: float, to: float, cuts: Array = []) -> Array:
	var runs := []
	var a := from
	while a < to:
		var length := minf(26.0, to - a)
		var pieces := [[a, a + length]]
		for cut in cuts:
			var next := []
			for p in pieces:
				if p[1] <= cut[0] or p[0] >= cut[1]:
					next.append(p)
					continue
				if p[0] < cut[0]:
					next.append([p[0], cut[0]])
				if p[1] > cut[1]:
					next.append([cut[1], p[1]])
			pieces = next
		for p in pieces:
			if p[1] - p[0] >= 2.0:
				runs.append(p)
		a += length + 3.0
	return runs

## Валы снега вдоль обочин: [центр x/z, размер x/z]. Разрывы — выезд со двора, перекрёсток, площадка киоска.
static func snow_banks() -> Array:
	var banks := []
	var w := BANK.x
	# Улица A: [x от, x до, z, вырезы]. С x = −97, а не −100: щель 0 м между валом и краем карты — тупик для машины (ART-06).
	# Северный вал разорван улицей D (x −66…−54) с запасом под тротуары (ARENA-01).
	# Улица C (ARENA-01): северный вал — внешний угол кольца, от западного края вала D до восточного края вала B;
	# южный — между углами, с вырезом у торца гаражей киоска (иначе щель 0,8 м между валом и стеной).
	# Остановка троллейбуса A (ARENA-01 fix P2-1): северный вал вырезан на STOP_A_CUT — двери к павильону, не в снег.
	for span in [[-97.0, 56.0, 24.4, [[-70.0, -52.0], STOP_A_CUT]], [-97.0, -26.0, 39.6, []], [24.0, 100.0, 39.6, []],
			[-67.2, 77.2, -106.6, []], [-53.0, 60.0, -93.4, [[40.0, 52.0]]]]:
		for run in _bank_runs(span[0], span[1], span[3]):
			banks.append([Vector2((run[0] + run[1]) * 0.5, span[2]), Vector2(run[1] - run[0], w)])
	# Улица B: [x, z от, z до, вырезы]. Восточный вал кончается у торца H8 (z = 15), а не на 19: между концом вала
	# и углом H8 «Лада» зажималась поперёк и не выруливала (STUCK, SnowBank@(79.3,13.4); POLISH-02).
	# Западный кусок z −110…−94 снят — там теперь улица C; восточный начинается у внешнего угла C∩B (z −107,2).
	# Улица D (ARENA-01): вдоль H5 (z 0…14) валов нет — между валом и стеной осталась бы щель 0,8 м.
	# Западный вал B разорван у парковки киоска (z −60…−40, EXT-01): заезд с улицы B на KIOSK_ZONE и разворот
	# при отъезде (ROUTE_LEAVE_KIOSK) — радиус «Лады» на малой скорости ~4 м, разрыв короче не пропускал выезд налево.
	# Начала внутренних валов C (x −53) и D (z −88) подобраны так, чтобы опоры D_SPANS/C_SPANS стояли в валу, а не
	# в разрыве: столб посреди разрыва зажимал «Ладу» (STUCK, TrolleyPole@(4.8,−91.1)).
	for span in [[63.4, -60.0, 19.0, [[-60.0, -40.0]]], [76.6, -110.0, 15.0, [[-120.0, -107.2]]],
			[-66.6, -107.2, 21.0, [[-2.0, 16.0], [-43.0, -37.0]]], [-53.4, -88.0, 21.0, [[-2.0, 16.0], [-43.0, -37.0]]]]:
		for run in _bank_runs(span[1], span[2], span[3]):
			banks.append([Vector2(span[0], (run[0] + run[1]) * 0.5), Vector2(w, run[1] - run[0])])
	return banks

## Консоль уличного фонаря: смещение светильника от столба к проезжей части (сверка ART-04, черта 14).
const LAMP_ARM := 1.8
static func lamp_arm(p: Vector2) -> Vector2:
	if absf(p.y - 22.0) < 0.1:
		return Vector2(0, LAMP_ARM)       # улица A, север — к югу
	if absf(p.y - 42.0) < 0.1:
		return Vector2(0, -LAMP_ARM)      # улица A, юг — к северу
	if absf(p.x - LAMP_B_WEST) < 0.1:
		return Vector2(LAMP_ARM, 0)       # улица B, запад — к востоку
	if absf(p.x - LAMP_D_WEST) < 0.1:
		return Vector2(LAMP_ARM, 0)       # улица D, запад — к востоку
	if absf(p.y - LAMP_C_NORTH) < 0.1:
		return Vector2(0, LAMP_ARM)       # улица C, север — к югу
	return Vector2(-LAMP_ARM, 0)          # улица B, восток — к западу

## Все декоративные твёрдые коробки в формате SOLIDS.
static func decor_solids() -> Array:
	var solids := []
	for p in street_lamps():
		solids.append(["StreetLamp", "lamp", p, Vector3(0.25, LAMP_HEIGHT, 0.25)])
	for bank in snow_banks():
		solids.append(["SnowBank", "snow_bank", bank[0], Vector3(bank[1].x, BANK.y, bank[1].y)])
	for p in TREES:
		solids.append(["Birch", "tree", p, Vector3(0.3, 7.0, 0.3)])
	for sign in STREET_SIGNS:
		solids.append(["StreetSign", "sign_post", sign[0], Vector3(0.12, 3.2, 0.12)])
	solids.append(["BusPavilion", "pavilion", BUS_PAVILION[0], BUS_PAVILION[1]])
	solids.append(["KioskPavilion", "pavilion", KIOSK_PAVILION[0], KIOSK_PAVILION[1]])   # EXT: укрытие у киоска
	solids.append(["KioskBins", "bins", KIOSK_BINS[0], KIOSK_BINS[1]])
	for p in trolley_poles():
		solids.append(["TrolleyPole", "lamp", p, Vector3(0.25, LAMP_HEIGHT, 0.25)])
	for p in POPLARS:
		solids.append(["Poplar", "poplar", p, POPLAR_TRUNK])
	for car in PARKED:
		solids.append(["ParkedCar", "parked_car", car[0], Vector3(4.1, 1.4, 1.7) if car[1] else Vector3(1.7, 1.4, 4.1)])
	for p in CARPET_BAR:
		solids.append(["CarpetBar", "carpet_bar", p, CARPET_POST])
	solids.append(["TrashBins", "bins", BINS[0], BINS[1]])
	solids.append(["TrashBinsH10", "bins", H10_BINS[0], H10_BINS[1]])
	solids.append(["Shop24", "shop24", SHOP24[0], SHOP24[1]])
	solids.append(["Billboard", "billboard", BILLBOARD, Vector3(0.5, 6.0, 0.5)])
	return solids + PROPS_SOLIDS   # PROPS-01: в конце — номера прежних коробок не сдвигаются

## SOLIDS + декор: для геометрии и проверок свободного места.
static func all_solids() -> Array:
	return SOLIDS + decor_solids() + perimeter_solids()

# PERIMETER-01: permanent scenery. Existing SOLIDS/decor indices stay stable (C11).
# Every collider is an ordinary canonical AABB; curved stock is cut into inscribed
# strips so navigation, coin placement, camera and physics see the same geometry.
const ER2K = preload("res://game/vehicles/er2k_train_visual.gd")
const TRAIN_COUNT := 10
const TRAIN_CENTRE := Vector2(-100.2, 32.0)
const TRAIN_CURVE := 0.0016
const PERIMETER_STRIP := 0.5
const PERIMETER_WALLS := [
	[Vector2(-99.2, 10), Vector2(-86, -30), 0.65, 4.2],
	[Vector2(-99.2, 110), Vector2(-89, 110), 0.7, 4.2],
	[Vector2(99, 18), Vector2(96, 18), 0.55, 4.2],
	[Vector2(99, 46), Vector2(99, 49), 0.55, 4.2],
	[Vector2(99, 49), Vector2(89.8, 49), 0.55, 4.2],
	# Transverse returns close the rear strip between shutter and map edge.
	[Vector2(99, 18), Vector2(100.4, 18), 0.55, 4.2],
	[Vector2(99, 46), Vector2(100.4, 46), 0.55, 4.2],
	# Local post sidewalls cover the outside corners of both transverse returns.
	[Vector2(99.2, 5), Vector2(99.2, 18), 0.55, 4.2],
	[Vector2(99.2, 46), Vector2(99.2, 62), 0.55, 4.2],
	[Vector2(96, 18), Vector2(96, 14.8), 0.55, 4.2],
	[Vector2(89.8, 49), Vector2(89.8, 60.2), 0.55, 4.2],
]
const PERIMETER_WARNINGS := [
	[Vector2(-52, 22), PI * 0.5, "ПЕРЕЕЗД ЗАКРЫТ", "СКВОЗНОГО ПРОЕЗДА НЕТ"],
	[Vector2(49, 42), -PI * 0.5, "ПРОЕЗД ЗАКРЫТ", "РАЗВОРОТ ПЕРЕД ПОСТОМ"],
]
static var _perimeter_cache: Array = []
static var _train_cache: Array = []

## [centre x/z, yaw]. Equal distances along the track, not equal Z intervals.
static func train_cars() -> Array:
	if not _train_cache.is_empty():
		return _train_cache
	for i in TRAIN_COUNT:
		var distance := (i - 4) * ER2K.CAR_LENGTH
		var p := train_track(distance)
		var tangent := train_track(distance + 0.01) - train_track(distance - 0.01)
		_train_cache.append([p, atan2(tangent.x, tangent.y)])
	return _train_cache

static func train_track(distance: float) -> Vector2:
	if distance >= 0.0:
		return TRAIN_CENTRE + Vector2(0, distance)
	var lo := 0.0
	var hi := -distance
	for iteration in 28:
		var u := (lo + hi) * 0.5
		var k := TRAIN_CURVE * 2.0
		var slope := k * u
		var root := sqrt(1.0 + slope * slope)
		var arc := 0.5 * (u * root + log(slope + root) / k)
		if arc < -distance:
			lo = u
		else:
			hi = u
	var u := (lo + hi) * 0.5
	return TRAIN_CENTRE + Vector2(-TRAIN_CURVE * u * u, -u)

static func _perimeter_cross_section(corners: Array[Vector2], z: float) -> Vector2:
	var lo := INF
	var hi := -INF
	for j in 4:
		var a := corners[j]
		var b := corners[(j + 1) % 4]
		if z < minf(a.y, b.y) - 0.00001 or z > maxf(a.y, b.y) + 0.00001:
			continue
		if absf(b.y - a.y) < 0.00001:
			lo = minf(lo, minf(a.x, b.x))
			hi = maxf(hi, maxf(a.x, b.x))
		else:
			var x := lerpf(a.x, b.x, (z - a.y) / (b.y - a.y))
			lo = minf(lo, x)
			hi = maxf(hi, x)
	return Vector2(lo, hi)

static func _perimeter_obb(out: Array, id: String, kind: String, centre: Vector2, width: float, length: float, height: float, yaw: float) -> void:
	var u := Vector2(cos(yaw), -sin(yaw)) * width * 0.5
	var v := Vector2(sin(yaw), cos(yaw)) * length * 0.5
	var corners: Array[Vector2] = [centre - u - v, centre + u - v, centre + u + v, centre - u + v]
	# Cross-section bounds change slope at every vertex. Keep those cuts even
	# for a short, almost straight gangway, whose middle otherwise disappears.
	var cuts: Array[float] = []
	for p in corners:
		cuts.append(p.y)
	cuts.sort()
	var index := 0
	for interval in range(cuts.size() - 1):
		var z0 := cuts[interval]
		var z1 := cuts[interval + 1]
		if z1 - z0 <= 0.000001:
			continue
		var count := maxi(1, ceili((z1 - z0) / PERIMETER_STRIP))
		for j in count:
			var a := lerpf(z0, z1, float(j) / count)
			var b := lerpf(z0, z1, float(j + 1) / count)
			var ca := _perimeter_cross_section(corners, a)
			var cb := _perimeter_cross_section(corners, b)
			var left := maxf(ca.x, cb.x)
			var right := minf(ca.y, cb.y)
			if right - left > 0.001:
				out.append([id + "_%02d" % index, kind, Vector2((left + right) * 0.5, (a + b) * 0.5), Vector3(right - left, height, b - a)])
			index += 1

static func perimeter_solids() -> Array:
	if not _perimeter_cache.is_empty():
		return _perimeter_cache
	var out := []
	var cars := train_cars()
	for i in cars.size():
		var car: Array = cars[i]
		# Full-width body ends at the eave; the roof/pantograph never enlarge collision.
		_perimeter_obb(out, "RailCoach%d" % i, "perimeter_train", car[0], ER2K.BODY_WIDTH, ER2K.BODY_LENGTH, ER2K.EAVE, car[1])
		if i > 0:
			var prev: Array = cars[i - 1]
			var a: Vector2 = prev[0] + Vector2(sin(prev[1]), cos(prev[1])) * ER2K.HALF_BODY
			var b: Vector2 = car[0] - Vector2(sin(car[1]), cos(car[1])) * ER2K.HALF_BODY
			var mid := (a + b) * 0.5
			# Solid, visible gangway joins the actual ends, including their curve offset.
			_perimeter_obb(out, "RailGangway%d" % i, "perimeter_gangway", mid, 2.6, a.distance_to(b) + 0.08, 3.5, atan2(b.x - a.x, b.y - a.y))
	for i in PERIMETER_WALLS.size():
		var wall: Array = PERIMETER_WALLS[i]
		var a: Vector2 = wall[0]
		var b: Vector2 = wall[1]
		# Axial runs are one exact union box: no internal seams for shape sweeps.
		if a.x == b.x or a.y == b.y:
			out.append(["PerimeterWall%d_0" % i, "perimeter_wall", (a + b) * 0.5, Vector3(absf(a.x - b.x) + wall[2], wall[3], absf(a.y - b.y) + wall[2])])
			continue
		# Diagonal masonry keeps its visible stepped outline.
		var count := ceili(a.distance_to(b) / 0.4)
		for j in count:
			var p := a.lerp(b, float(j) / count)
			var q := a.lerp(b, float(j + 1) / count)
			out.append(["PerimeterWall%d_%d" % [i, j], "perimeter_wall", (p + q) * 0.5, Vector3(absf(p.x - q.x) + wall[2], wall[3], absf(p.y - q.y) + wall[2])])
	out.append(["LeninEastShutter", "perimeter_shutter", Vector2(99, 32), Vector3(0.55, 4.2, 28.2)])
	out.append(["LeninPoliceCar", "perimeter_police", Vector2(91, 32), Vector3(1.62, 1.45, 4.13)])
	for z in [25.5, 38.5]:
		out.append(["PoliceBarrier%d" % int(z), "perimeter_barrier", Vector2(91, z), Vector3(0.8, 1.1, 6.0)])
	for z in [24.0, 40.0]:
		out.append(["CrossingPedestal%d" % int(z), "perimeter_pedestal", Vector2(-90, z), Vector3(0.6, 1.25, 0.6)])
	for i in PERIMETER_WARNINGS.size():
		var warning: Array = PERIMETER_WARNINGS[i]
		out.append(["ExitWarning%d" % i, "perimeter_sign", warning[0], Vector3(0.12, 3.1, 0.12)])
	_perimeter_cache = out
	return out

static func ground_point(id: StringName) -> Vector3:
	match id:
		&"spawn": return SPAWN
		&"babka": return BABKA
		&"car": return CAR_SPAWN
		&"kiosk": return KIOSK
		&"vendor": return VENDOR_WINDOW
	return Vector3.INF

